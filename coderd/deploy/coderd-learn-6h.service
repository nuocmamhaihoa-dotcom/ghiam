[Unit]
Description=coderd study without pause for six hours
After=coderd-model.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=2
User=coder
WorkingDirectory=/opt/coderd
Environment=HOME=/opt/coderd/var/home
EnvironmentFile=/opt/coderd/worker.env
ExecStartPre=+/bin/systemctl stop coderd-learn.timer
ExecStartPre=+/bin/systemctl stop coderd-learn.service
ExecStart=/opt/coderd/.venv/bin/python -m worker.study --hours 6
ExecStopPost=+/bin/systemctl start coderd-learn.timer

[Unit]
Description=coderd worker
After=network-online.target coderd.service

[Service]
Type=simple
User=coder
WorkingDirectory=/opt/coderd
EnvironmentFile=/opt/coderd/worker.env
ExecStart=/opt/coderd/.venv/bin/python -m worker.connect
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

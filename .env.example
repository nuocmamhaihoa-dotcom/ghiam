# Chép thành .env trên VPS rồi điền giá trị: cp .env.example .env
# Không commit file .env. Sao lưu .env cùng database: mất ENCRYPTION_KEY là mất mật khẩu proxy đã lưu.

# Tên miền đã trỏ bản ghi A/AAAA về IP của VPS; Caddy tự xin chứng chỉ HTTPS cho tên miền này.
DOMAIN=scope.example.com
# Email nhận thông báo chứng chỉ từ Let's Encrypt.
ACME_EMAIL=admin@example.com

# Mật khẩu Postgres, chỉ dùng chữ và số vì nó nằm trong DATABASE_URL. Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=

# Khoá ký phiên đăng nhập dashboard, ít nhất 32 ký tự. Tạo bằng: openssl rand -hex 32
SECRET_KEY=
# Khoá mã hoá mật khẩu proxy và link đổi IP trong database. Tạo bằng:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

ADMIN_USERNAME=admin
# Mật khẩu đăng nhập dashboard, ít nhất 8 ký tự.
ADMIN_PASSWORD=

# Token cho agent trên máy PC, cách nhau bằng dấu phẩy; nên cấp mỗi máy một token để thu hồi riêng.
# Tạo mỗi token bằng: openssl rand -hex 24
AGENT_TOKENS=

# Trang kiểm tra IP ra của proxy, trả JSON có trường "ip" (thêm "country" / "org" nếu có).
PROXY_CHECK_URLS=https://ipinfo.io/json,https://api.ipify.org?format=json
# Tự kiểm tra sống/chết toàn bộ kho proxy mỗi bao nhiêu giây (0 = tắt).
PROXY_HEALTH_CHECK_INTERVAL_SEC=900
# Thời hạn mặc định và tối đa của một lượt máy PC thuê proxy (agent tự gia hạn khi còn dùng).
PROXY_LEASE_DEFAULT_TTL_SEC=600
PROXY_LEASE_MAX_TTL_SEC=3600

LOG_LEVEL=INFO

# Copy to .env and adjust

# SQLite (default, single machine)
DATABASE_URL=sqlite+aiosqlite:///./data/fb_poller.db

# Postgres later (2-PC / production)
# DATABASE_URL=postgresql+asyncpg://fb:fb@127.0.0.1:5432/fb_poller
# REDIS_URL=redis://127.0.0.1:6379/0

HOT_SIZE=100
# Start at 45s; drop to 30 after p95<=5s and success>=85%
HOT_INTERVAL_SEC=45
WARM_INTERVAL_SEC=150
COLD_INTERVAL_SEC=600
BOOST_ON_NEW_SEC=1200

WORKERS=2
WARM_COLD_MAX_INFLIGHT=3
HOT_JOB_TIMEOUT_MS=7000
HOT_MAX_COMMENTS_PAGE=20
BROWSER_RESTART_EVERY_JOBS=80
HEADLESS=true

WORKER_ID=pc20-1
ROLE=all

PROXIES_STATIC_FILE=./data/proxies_static.txt
PROXIES_4G_FILE=./data/proxies_4g.txt

# TikTok public OSINT scanner (separate SQLite / Redis DB index)
# TIKTOK_DATABASE_URL=sqlite:///./data/tiktok_osint.db
# TIKTOK_REDIS_URL=redis://127.0.0.1:6379/1
# TIKTOK_MAX_ATTEMPTS=3
# TIKTOK_MIN_DELAY_SEC=1.5

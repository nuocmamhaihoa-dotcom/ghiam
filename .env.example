# AQATE local / docker-compose defaults
APP_NAME=aqate-api
APP_ENV=development
DEBUG=true
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://aqate:aqate@localhost:5432/aqate
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aqate
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_SECONDS=900

LLM_JUDGE_ENABLED=false
OPENAI_API_KEY=
STT_MIN_AVG_CONFIDENCE=0.65

SEED_ADMIN_EMAIL=admin@aqate.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_TENANT_CODE=demo

LOG_LEVEL=INFO
LOG_JSON=true

[Unit]
Description=fb-poller VPS hub (control plane + comment dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fb-poller
EnvironmentFile=/opt/fb-poller/control_data/server.env
ExecStart=/opt/fb-poller/.venv/bin/python -m control_plane
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

[Unit]
Description=TikTok public OSINT API
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=tiktok
Group=tiktok
WorkingDirectory=/opt/tiktok-osint
EnvironmentFile=/opt/tiktok-osint/tiktok.env
ExecStart=/opt/tiktok-osint/.venv/bin/uvicorn tiktok_osint.api.app:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
